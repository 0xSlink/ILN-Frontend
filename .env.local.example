# Environment Variables Template
# Copy this file to .env.local and customize as needed for your environment
#
# NOTE: Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Never put secrets in NEXT_PUBLIC_ variables.

# ─── Supabase (Required) ──────────────────────────────────────────────────────
# Supabase project URL – get from https://app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase anonymous (public) key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Supabase service role key (server-only, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stellar Contract Configuration ───────────────────────────────────────────
# Testnet smart contract address for the Invoice Liquidity Network
NEXT_PUBLIC_CONTRACT_ID=CD3TE3IAHM737P236XZL2OYU275ZKD6MN7YH7PYYAXYIGEH55OPEWYJC

# ─── Stellar Network Configuration ────────────────────────────────────────────
# Network passphrase for testnet
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# RPC endpoint for Stellar testnet
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
# Human-readable network identifier (TESTNET, MAINNET, LOCAL)
NEXT_PUBLIC_NETWORK_NAME=TESTNET
# Stellar network identifier (testnet, public)
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# ─── Token Configuration (Testnet) ────────────────────────────────────────────
# USDC token contract address on testnet
NEXT_PUBLIC_TESTNET_USDC_TOKEN_ID=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75
# EURC token contract address on testnet
NEXT_PUBLIC_TESTNET_EURC_TOKEN_ID=GDHU6WRG4IEQXM5NZ4BMPKOXHW76MZM4Y2IEMFDVXBSDP6SJY4ITNPP
# XLM token identifier (native asset)
NEXT_PUBLIC_TESTNET_XLM_TOKEN_ID=native-xlm

# ─── Governance Configuration ─────────────────────────────────────────────────
# Admin address for governance operations
NEXT_PUBLIC_GOVERNANCE_ADMIN_ADDRESS=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF
# Optional governance contract address
NEXT_PUBLIC_GOVERNANCE_CONTRACT_ID=

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Enable Mock Service Worker API mocks in local development (set to "enabled")
NEXT_PUBLIC_API_MOCKING=disabled
# Enable insurance pool UI (true/false)
NEXT_PUBLIC_INSURANCE_POOL_ENABLED=false
# Enable oracle price feed (true/false)
NEXT_PUBLIC_ORACLE_ENABLED=false
# Enable Invoice NFT display (true/false)
NEXT_PUBLIC_NFT_ENABLED=false
# Display the global protocol-maintenance banner (true/false). Toggle via Vercel and redeploy.
NEXT_PUBLIC_MAINTENANCE_MODE=false
# Optional override for NFT contract address (defaults to NEXT_PUBLIC_CONTRACT_ID)
NEXT_PUBLIC_NFT_CONTRACT_ID=
# Soroban method for NFT metadata resolution
NEXT_PUBLIC_NFT_METADATA_METHOD=token_uri
# Optional event hints for NFT event parsing (format: "mint:Minted,mint;transfer:Transfer,transfer")
NEXT_PUBLIC_NFT_EVENT_HINTS=

# ─── Indexer API ──────────────────────────────────────────────────────────────
# Indexer REST API base URL (used by ActivityFeed, charts, analytics)
# Exposed to browser (no secrets here)
NEXT_PUBLIC_INDEXER_API_URL=https://api.iln.example.com
# Indexer WebSocket URL (real-time updates)
# Used for live dashboard updates and contract event streaming
NEXT_PUBLIC_INDEXER_WS_URL=ws://localhost:8080/ws
# Server-side indexer URL (leaderboard, server functions)
# Falls back to NEXT_PUBLIC_INDEXER_API_URL if not set
INDEXER_URL=
# Server-side API key for authenticated indexer calls (rate-limit bypass)
# NEVER expose to client — server-side only
INDEXER_API_KEY=

# ─── Notifications & Email ────────────────────────────────────────────────────
# Notification API base URL
NOTIFICATION_API=
# Resend API key for email delivery (payer reminders)
RESEND_API_KEY=
# Cron secret for protected API routes
CRON_SECRET=
# Secret key for unsubscribe token generation (HMAC signing)
# Must be a cryptographically random value; minimum 32 bytes recommended
UNSUBSCRIBE_TOKEN_SECRET=

# ─── WalletConnect ────────────────────────────────────────────────────────────
# WalletConnect project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ─── App Configuration ────────────────────────────────────────────────────────
# Public app URL (used in email links, deep links)
NEXT_PUBLIC_APP_URL=https://app.iln.finance

# ─── Real-User Monitoring (RUM) ───────────────────────────────────────────────
# Optional beacon endpoint for real-user Core Web Vitals. When set, CWV metrics
# collected via useReportWebVitals are also forwarded here (navigator.sendBeacon)
# in addition to the in-app analytics bridge. See docs/performance-monitoring.md.
NEXT_PUBLIC_RUM_ENDPOINT=
# Public app version label used by in-app release notes
NEXT_PUBLIC_APP_VERSION=dev
# Public contract version label used by the admin health dashboard
NEXT_PUBLIC_CONTRACT_VERSION=testnet:CD3TE3IA

# ─── Error Tracking (#794) ────────────────────────────────────────────────────
# Sentry DSN for browser/OS/wallet-version enriched error reporting
# When set, `src/lib/errorTracking.ts` forwards enriched events to Sentry
#NEXT_PUBLIC_SENTRY_DSN=

# ─── Lighthouse CI Server (optional, #795) ────────────────────────────────────
# If you run an LHCI server, set these to push/upload trend data there as well
# (filesystem history + trend script work without a server)
#NEXT_PUBLIC_LHCI_SERVER_BASE_URL=
#LHCI_TOKEN=

# ─── GitHub Integration (Feedback API) ────────────────────────────────────────
# GitHub personal access token for feedback submission
GITHUB_TOKEN=
# GitHub repository owner
GITHUB_OWNER=
# GitHub repository name
GITHUB_REPO=

# ─── Customization ────────────────────────────────────────────────────────────
# To connect to a different Stellar network or contract:
#
# For Public Network:
#   NEXT_PUBLIC_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
#   NEXT_PUBLIC_RPC_URL=https://soroban-mainnet.stellar.org
#   NEXT_PUBLIC_NETWORK_NAME=MAINNET
#   NEXT_PUBLIC_STELLAR_NETWORK=public
#
# For Local Network (with stellar-cli):
#   NEXT_PUBLIC_NETWORK_PASSPHRASE=Stellar Development Foundation Network ; May 2024a
#   NEXT_PUBLIC_RPC_URL=http://localhost:8000/soroban/rpc
#   NEXT_PUBLIC_NETWORK_NAME=LOCAL
#
# ─── IMPORTANT ────────────────────────────────────────────────────────────────
# - This file should be added to .gitignore (it is by default)
# - Never commit secrets or API keys to version control
# - Testnet configuration is safe to commit as it's not production
