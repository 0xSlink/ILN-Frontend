# Production / Mainnet Environment Variables Template & Snapshot
# This template defines the canonical mainnet configuration for ILN Frontend.
# Used by scripts/check-env-example.mjs for CI configuration drift detection.
#
# NOTE: Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Never put secrets in NEXT_PUBLIC_ variables.

# ─── Supabase (Required) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://prod.supabase.iln.finance
NEXT_PUBLIC_SUPABASE_ANON_KEY=production-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=production-service-role-key-placeholder

# ─── Stellar Contract Configuration ───────────────────────────────────────────
# Mainnet smart contract address for the Invoice Liquidity Network
NEXT_PUBLIC_CONTRACT_ID=CB7N6E56V4K3Q7ZJ6DLR3W3Q6S5ZPYI32AOGI4A4X67E525U4FOWMAIN

# ─── Stellar Network Configuration ────────────────────────────────────────────
# Network passphrase for Stellar Public Mainnet (MUST match exact SDF mainnet passphrase)
NEXT_PUBLIC_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
# RPC endpoint for Stellar mainnet (Soroban RPC provider)
NEXT_PUBLIC_RPC_URL=https://soroban-mainnet.stellar.org
# Human-readable network identifier (PUBLIC or MAINNET)
NEXT_PUBLIC_NETWORK_NAME=PUBLIC
# Stellar network identifier (MUST be "public", NOT "mainnet" or "testnet")
NEXT_PUBLIC_STELLAR_NETWORK=public

# ─── Token Configuration (Mainnet) ────────────────────────────────────────────
# Mainnet USDC token contract address
NEXT_PUBLIC_TESTNET_USDC_TOKEN_ID=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMAIN
# Mainnet EURC token contract address
NEXT_PUBLIC_TESTNET_EURC_TOKEN_ID=GDHU6WRG4IEQXM5NZ4BMPKOXHW76MZM4Y2IEMFDVXBSDP6SJY4ITMAIN
# XLM token identifier (native asset is network-agnostic and identical across testnet/mainnet)
NEXT_PUBLIC_TESTNET_XLM_TOKEN_ID=native-xlm

# ─── Governance Configuration ─────────────────────────────────────────────────
# Mainnet governance admin address
NEXT_PUBLIC_GOVERNANCE_ADMIN_ADDRESS=GDMMAINNETADMINPUBKEYAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF
# Optional mainnet governance contract address
NEXT_PUBLIC_GOVERNANCE_CONTRACT_ID=CB7N6E56V4K3Q7ZJ6DLR3W3Q6S5ZPYI32AOGI4A4X67E525U4FOWGOVN

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Mock Service Worker must NEVER be enabled on production
NEXT_PUBLIC_API_MOCKING=disabled
# Feature flags default to false at initial mainnet launch
NEXT_PUBLIC_INSURANCE_POOL_ENABLED=false
NEXT_PUBLIC_ORACLE_ENABLED=false
NEXT_PUBLIC_NFT_ENABLED=false
NEXT_PUBLIC_MAINTENANCE_MODE=false
NEXT_PUBLIC_NFT_CONTRACT_ID=
NEXT_PUBLIC_NFT_METADATA_METHOD=token_uri
NEXT_PUBLIC_NFT_EVENT_HINTS=

# ─── Indexer API ──────────────────────────────────────────────────────────────
# Mainnet indexer REST API URL
NEXT_PUBLIC_INDEXER_API_URL=https://indexer.iln.finance
# Mainnet indexer WebSocket URL
NEXT_PUBLIC_INDEXER_WS_URL=wss://indexer.iln.finance/ws
# Server-side indexer URL
INDEXER_URL=https://indexer.iln.finance

# ─── Notifications & Email ────────────────────────────────────────────────────
NOTIFICATION_API=https://notifications.iln.finance
RESEND_API_KEY=production-resend-api-key-placeholder
CRON_SECRET=production-cron-secret-placeholder

# ─── WalletConnect ────────────────────────────────────────────────────────────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=production-walletconnect-project-id-placeholder

# ─── App Configuration ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://app.iln.finance
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_CONTRACT_VERSION=public:CB7N6E56

# ─── GitHub Integration (Feedback API) ────────────────────────────────────────
GITHUB_TOKEN=production-github-token-placeholder
GITHUB_OWNER=Invoice-Liquidity-Network
GITHUB_REPO=ILN-Frontend
